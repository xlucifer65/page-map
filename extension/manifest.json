{
  "manifest_version": 3,
  "name": "Page-Map",
  "version": "0.1.0",
  "description": "Lets your own AI agent read and drive web pages through structure instead of screenshots.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "options_page": "options.html"
}
