{
  "name": "page-map",
  "version": "0.1.0",
  "description": "Open-source Chrome extension + MCP server: let any AI agent read and control Chrome through page structure instead of screenshots \u2014 cheaper, faster, parallel agents, zero-token task replay.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "vitest run",
    "bench": "node scripts/bench.js",
    "install-host": "node scripts/install-host.js",
    "mcp": "node mcp/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chrome-extension",
    "browser-automation",
    "ai-agent",
    "computer-use",
    "claude-code",
    "cursor",
    "accessibility-tree",
    "multi-agent",
    "web-agent",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xlucifer65/page-map.git"
  }
